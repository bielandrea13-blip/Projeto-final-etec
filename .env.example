# GEMINI_API_KEY: Required for Gemini AI API calls if AI features are added.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Porta do servidor Express (definida automaticamente pela Railway em produção; padrão 3000).
PORT=3000

# MONGODB_URI: String de conexão do MongoDB Atlas (opcional em dev; se omitida, usa persistência local JSON).
# Exemplo: mongodb+srv://usuario:senha@cluster0.xxxxx.mongodb.net/kroma_db?retryWrites=true&w=majority
MONGODB_URI=""

# JWT_SECRET: Chave secreta usada pelo backend Express para assinar os tokens de autenticação.
JWT_SECRET="alterar-para-uma-chave-secreta-forte-em-producao"

# CORS_ORIGIN: Domínios permitidos pelo Express (ex: https://seu-projeto.vercel.app). Separe múltiplos por vírgula.
CORS_ORIGIN="*"

# VITE_API_URL: URL pública do backend na Railway (deixe vazio quando frontend e backend rodarem juntos).
# Exemplo na Vercel: https://sua-api.up.railway.app
VITE_API_URL=""
